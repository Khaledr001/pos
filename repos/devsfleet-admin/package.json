{
  "name": "@devsfleet/admin",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.2.2",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start --port 3000",
    "typecheck": "tsc --noEmit",
    "lint": "next lint",
    "test": "vitest run --passWithNoTests",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md,yml,yaml}\"",
    "clean": "rm -rf .next .turbo *.tsbuildinfo",
    "docker:build": "docker build -t devsfleet/admin:$(git rev-parse --short HEAD) -t devsfleet/admin:latest ."
  },
  "dependencies": {
    "@devsfleet/shared-types": "workspace:*",
    "@devsfleet/shared-utils": "workspace:*",
    "@tanstack/react-query": "^5.90.2",
    "lucide-react": "^1.31.0",
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.14",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.1.14",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
