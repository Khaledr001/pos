# =============================================================================
# DevsFleet API — environment
# Copy to .env and fill in.  NEVER commit .env
# =============================================================================

NODE_ENV=development

# -----------------------------------------------------------------------------
# Database (PostgreSQL 18)
# -----------------------------------------------------------------------------
# APP role: RLS is ENFORCED. Every runtime query uses this.
DATABASE_URL=postgres://devsfleet_app:app_dev_password@localhost:5432/devsfleet

# MIGRATOR role: table owner, BYPASSRLS. Migrations + seed only. Never at runtime.
DATABASE_URL_MIGRATOR=postgres://devsfleet_migrator:migrator_dev_password@localhost:5432/devsfleet

DATABASE_POOL_MAX=10
DATABASE_SSL=false

# -----------------------------------------------------------------------------
# Redis (cache, BullMQ queues, sync pub/sub)
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# -----------------------------------------------------------------------------
# Auth
# -----------------------------------------------------------------------------
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-dev-only-access-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=change-me-dev-only-refresh-secret
JWT_REFRESH_TTL=30d
# POS terminals stay logged in far longer than admin sessions
JWT_POS_REFRESH_TTL=90d
BCRYPT_ROUNDS=12

# -----------------------------------------------------------------------------
# API
# -----------------------------------------------------------------------------
API_PORT=3001
API_PREFIX=api/v1
API_CORS_ORIGINS=http://localhost:3000,http://localhost:5173
THROTTLE_TTL=60
THROTTLE_LIMIT=120

# -----------------------------------------------------------------------------
# Object storage (MinIO — product images, quotation PDFs, receipts)
# -----------------------------------------------------------------------------
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=devsfleet
S3_SECRET_KEY=devsfleet_dev_password
S3_BUCKET=devsfleet
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_URL=http://localhost:9000/devsfleet

# -----------------------------------------------------------------------------
# WhatsApp — Meta Cloud API
# -----------------------------------------------------------------------------
WHATSAPP_ENABLED=false
WHATSAPP_API_VERSION=v23.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=change-me-webhook-verify-token
WHATSAPP_APP_SECRET=

# -----------------------------------------------------------------------------
# AI / LLM
# -----------------------------------------------------------------------------
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
LLM_MAX_TOKENS=1024
LLM_TIMEOUT_MS=20000
