# =============================================================================
# deploy/.env — production stack configuration
#
#   cp .env.prod.example .env    then fill in every value
#
# This file configures the STACK: domains, database passwords, image tags.
# Application settings for the API live in deploy/api.env (copy that from
# apps/api/.env.example).
#
# Never commit either file.
# =============================================================================

# -----------------------------------------------------------------------------
# Domains — DNS A records must already point at this VPS before first start,
# or Caddy's certificate request will fail.
# -----------------------------------------------------------------------------
DOMAIN_ADMIN=pos.devsfleet.com
DOMAIN_API=api.devsfleet.com
DOMAIN_CDN=cdn.devsfleet.com
ACME_EMAIL=you@devsfleet.com

# -----------------------------------------------------------------------------
# Database — generate with: openssl rand -base64 32
#
# Two roles, and the separation is the whole basis of tenant isolation:
#   migrator  owns the schema, BYPASSES RLS. Migrations and backups only.
#   app       what the API connects as. RLS is ENFORCED against it.
# -----------------------------------------------------------------------------
MIGRATOR_DB_PASSWORD=
APP_DB_PASSWORD=

REDIS_PASSWORD=

# -----------------------------------------------------------------------------
# Object storage
# -----------------------------------------------------------------------------
S3_ACCESS_KEY=
S3_SECRET_KEY=

# -----------------------------------------------------------------------------
# Images
#
# REGISTRY=devsfleet builds locally on the VPS. Point it at a registry
# (ghcr.io/<you>, registry.digitalocean.com/<you>) once CI builds the images,
# so the production host stops needing a toolchain.
#
# TAG: use the git SHA, not `latest`. `latest` makes a rollback ambiguous.
# -----------------------------------------------------------------------------
REGISTRY=devsfleet
TAG=latest
