# =============================================================================
# DevsFleet POS — environment
# Copy to .env and fill in.  NEVER commit .env
# =============================================================================

# API URL — where the POS sends requests
VITE_API_URL=http://localhost:3001/api/v1

# Local SQLite file, relative to Electron userData dir
POS_DB_FILE=devsfleet-pos.sqlite
POS_SYNC_INTERVAL_MS=30000
