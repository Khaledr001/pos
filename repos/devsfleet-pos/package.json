{
  "name": "@devsfleet/pos",
  "version": "0.1.0",
  "private": true,
  "main": "dist-electron/main.js",
  "packageManager": "pnpm@11.2.2",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --dry",
    "test": "vitest run --passWithNoTests",
    "test:sync": "vitest run src/**/sync*.test.ts",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md,yml,yaml}\"",
    "package": "pnpm build && electron-builder --dir",
    "dist": "pnpm build && electron-builder",
    "clean": "rm -rf dist dist-electron release .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@devsfleet/shared-types": "workspace:*",
    "@devsfleet/shared-utils": "workspace:*",
    "better-sqlite3": "^12.4.1",
    "electron-updater": "^6.6.2",
    "node-thermal-printer": "^4.5.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.3",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.3",
    "electron": "^38.2.0",
    "electron-builder": "^26.0.12",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "vite": "^7.1.7",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vitest": "^3.2.4"
  }
}
