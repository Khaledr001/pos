{
  "name": "@devsfleet/pos",
  "version": "0.1.0",
  "private": true,
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "test": "vitest run --passWithNoTests && pnpm test:electron",
    "test:sync": "vitest run src/**/sync*.test.ts",
    "package": "pnpm build && electron-builder --dir",
    "dist": "pnpm build && electron-builder",
    "clean": "rm -rf dist dist-electron release .turbo *.tsbuildinfo",
    "dev:ui": "POS_RENDERER_ONLY=1 vite --port 5173 --strictPort",
    "rebuild:native": "electron-rebuild -f -w better-sqlite3",
    "postinstall": "electron-rebuild -f -w better-sqlite3",
    "test:electron": "ELECTRON_RUN_AS_NODE=1 electron ./node_modules/vitest/vitest.mjs run --config vitest.electron.config.ts --passWithNoTests"
  },
  "dependencies": {
    "@devsfleet/shared-types": "workspace:*",
    "@devsfleet/shared-utils": "workspace:*",
    "better-sqlite3": "^12.4.1",
    "date-fns": "^4.4.0",
    "electron-updater": "^6.6.2",
    "lucide-react": "^1.31.0",
    "node-thermal-printer": "^4.5.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.3",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.3",
    "electron": "^38.2.0",
    "electron-builder": "^26.0.12",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.2",
    "vite": "^7.1.7",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vitest": "^3.2.4"
  }
}
