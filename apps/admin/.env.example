# =============================================================================
# apps/admin — service-owned configuration
#
# The admin panel holds NO database credentials and NO secrets. It talks to the
# API over HTTP and nothing else, which is precisely what lets it sit on a
# different host — or behind a CDN — without carrying anything sensitive.
#
# Copy to apps/admin/.env for local development.
# =============================================================================

NODE_ENV=production
PORT=3000

# -----------------------------------------------------------------------------
# The API this panel talks to.
#
# NEXT_PUBLIC_* is INLINED INTO THE CLIENT BUNDLE AT BUILD TIME. It is not read
# at runtime, so changing it requires rebuilding the image, not restarting the
# container:
#
#   docker build --build-arg NEXT_PUBLIC_API_URL=https://api.devsfleet.com/api/v1 \
#     -f apps/admin/Dockerfile -t devsfleet-admin .
#
# Single host now:      http://localhost:3001/api/v1
# Split hosts later:    https://api.devsfleet.com/api/v1
#                       (and add this panel's origin to API_CORS_ORIGINS)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=https://api.devsfleet.com/api/v1
NEXT_PUBLIC_APP_NAME=DevsFleet

NEXT_TELEMETRY_DISABLED=1
