# =============================================================================
# apps/api — service-owned configuration
#
# Copy to apps/api/.env for local development, or supply these as real
# environment variables in production (compose `environment:`, systemd, or your
# secret manager — see docs/DEPLOYMENT.md).
#
# This file is the complete contract for running the API. If the API can start
# with only what is listed here, it is independently deployable. Nothing may be
# added that only exists inside the monorepo.
#
# For local dev you can skip this file entirely — the repo-root .env is read as
# a fallback so `pnpm dev` works with one file.
# =============================================================================

NODE_ENV=production

# -----------------------------------------------------------------------------
# Database — the APP role, with RLS ENFORCED.
# Never point this at devsfleet_migrator: that role bypasses row-level security
# and the API refuses to start if it detects it.
# -----------------------------------------------------------------------------
DATABASE_URL=postgres://devsfleet_app:CHANGE_ME@postgres:5432/devsfleet
DATABASE_POOL_MAX=10
DATABASE_SSL=false

REDIS_URL=redis://redis:6379

# -----------------------------------------------------------------------------
# Auth — generate each with: openssl rand -base64 48
# The two secrets MUST differ; the API refuses to boot in production otherwise,
# because sharing them lets an access token be replayed as a refresh token.
# -----------------------------------------------------------------------------
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_TTL=30d
JWT_POS_REFRESH_TTL=90d
BCRYPT_ROUNDS=12

# -----------------------------------------------------------------------------
# HTTP
# -----------------------------------------------------------------------------
API_PORT=3001
API_PREFIX=api/v1

# Comma-separated. Must list every origin that calls this API — the admin panel
# and, once the POS runs against a remote host, nothing else (Electron sends no
# Origin header). Add the admin's real domain when it moves to its own server.
API_CORS_ORIGINS=https://pos.devsfleet.com

THROTTLE_TTL=60
THROTTLE_LIMIT=120

# -----------------------------------------------------------------------------
# Object storage — product images, quotation PDFs
# -----------------------------------------------------------------------------
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=devsfleet
S3_FORCE_PATH_STYLE=true
# The URL a browser uses to fetch an image. Differs from S3_ENDPOINT once MinIO
# sits behind the reverse proxy.
S3_PUBLIC_URL=https://cdn.devsfleet.com/devsfleet

# -----------------------------------------------------------------------------
# WhatsApp — Meta Cloud API (Phase 4)
# Setting WHATSAPP_ENABLED=true makes the four values below mandatory; the API
# will not boot without WHATSAPP_APP_SECRET, since webhook signatures could not
# be verified and anyone who learned the URL could inject messages.
# -----------------------------------------------------------------------------
WHATSAPP_ENABLED=false
WHATSAPP_API_VERSION=v23.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# -----------------------------------------------------------------------------
# AI (Phase 4)
# -----------------------------------------------------------------------------
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
LLM_MAX_TOKENS=1024
LLM_TIMEOUT_MS=20000
