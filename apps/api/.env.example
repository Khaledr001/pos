# =============================================================================
# apps/api — service-owned configuration
#
# Copy to apps/api/.env for local development, or supply these as real
# environment variables in production (compose `environment:`, systemd, or your
# secret manager — see docs/DEPLOYMENT.md).
#
# This file is the complete contract for running the API. If the API can start
# with only what is listed here, it is independently deployable. Nothing may be
# added that only exists inside the monorepo.
#
# For local dev you can skip this file entirely — the repo-root .env is read as
# a fallback so `pnpm dev` works with one file.
# =============================================================================

NODE_ENV=production

# -----------------------------------------------------------------------------
# Database — the APP role, with RLS ENFORCED.
# Never point this at devsfleet_migrator: that role bypasses row-level security
# and the API refuses to start if it detects it.
# -----------------------------------------------------------------------------
DATABASE_URL=postgres://devsfleet_app:CHANGE_ME@postgres:5432/devsfleet
DATABASE_POOL_MAX=10
DATABASE_SSL=false

REDIS_URL=redis://redis:6379

# -----------------------------------------------------------------------------
# Auth — generate each with: openssl rand -base64 48
# The two secrets MUST differ; the API refuses to boot in production otherwise,
# because sharing them lets an access token be replayed as a refresh token.
# -----------------------------------------------------------------------------
JWT_ACCESS_SECRET=weufbawibew3981fhahg30EWWEFEWF9dlv
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=wKzU+L70zHlOIMw9xI9v2N75pQ5jH0TzH0TzH0TzH0TzH0TzH0T
JWT_REFRESH_TTL=30d
JWT_POS_REFRESH_TTL=90d
BCRYPT_ROUNDS=12

# -----------------------------------------------------------------------------
# HTTP
# -----------------------------------------------------------------------------
API_PORT=3001
API_PREFIX=api/v1

# Comma-separated. Must list every origin that calls this API — the admin panel
# and, once the POS runs against a remote host, nothing else (Electron sends no
# Origin header). Add the admin's real domain when it moves to its own server.
API_CORS_ORIGINS=https://pos.devsfleet.com

THROTTLE_TTL=60
THROTTLE_LIMIT=120

# -----------------------------------------------------------------------------
# Object storage — product images, quotation PDFs
# -----------------------------------------------------------------------------
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=devsfleet
S3_FORCE_PATH_STYLE=true
# The URL a browser uses to fetch an image. Differs from S3_ENDPOINT once MinIO
# sits behind the reverse proxy.
S3_PUBLIC_URL=https://cdn.devsfleet.com/devsfleet

# -----------------------------------------------------------------------------
# Email — shopper notifications (order updates, quotes, back-in-stock)
# One platform SMTP account for every shop (SES, Postmark, Resend SMTP, ...).
# Leave SMTP_HOST empty in development: mail is logged, not sent.
# -----------------------------------------------------------------------------
MAIL_DRIVER=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM_ADDRESS=

# -----------------------------------------------------------------------------
# WhatsApp — Meta Cloud API (Phase 4)
# Setting WHATSAPP_ENABLED=true makes the four values below mandatory; the API
# will not boot without WHATSAPP_APP_SECRET, since webhook signatures could not
# be verified and anyone who learned the URL could inject messages.
# -----------------------------------------------------------------------------
WHATSAPP_ENABLED=false
WHATSAPP_API_VERSION=v23.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# --- WhatsApp Embedded Signup (DevsFleet's own Meta app) ----------------------
# Lets a business connect its number by logging into Meta in a popup, including
# a number it keeps using in the WhatsApp Business app ("coexistence"). All four
# are required; leave any blank and only the manual setup is offered.
# Setup checklist: docs/WHATSAPP_EMBEDDED_SIGNUP.md
META_APP_ID=
# Server-only. Signs webhooks for numbers connected this way.
META_APP_SECRET=
# Meta App Dashboard → Facebook Login for Business → Configurations → the Embedded Signup config's ID.
META_EMBEDDED_SIGNUP_CONFIG_ID=
# The verify token you type into the app's WhatsApp webhook settings in Meta. Any long random string.
META_WEBHOOK_VERIFY_TOKEN=

# -----------------------------------------------------------------------------
# AI (Phase 4)
# -----------------------------------------------------------------------------
LLM_PROVIDER=deepseek
# Blank = the provider's recommended default (deepseek-v4-flash).
LLM_MODEL=
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
LLM_MAX_TOKENS=1024
LLM_TIMEOUT_MS=20000

# -----------------------------------------------------------------------------
# Online store (apps/storefront)
# -----------------------------------------------------------------------------
# Signs shopper tokens. Optional — derived from JWT_ACCESS_SECRET when blank,
# which is still a different key from the staff one.
STOREFRONT_JWT_SECRET=
# Sent to each storefront's /api/revalidate when prices or stock change.
# Must match REVALIDATE_SECRET on the storefront. Blank = pages expire on TTL.
STOREFRONT_REVALIDATE_SECRET=
# Shared with the storefront server. Without it every shopper counts against
# the storefront's single IP in the rate limiter. Generate: openssl rand -hex 32
STOREFRONT_PROXY_SECRET=

# The platform domain tenants get a free shop address on: "devsfleet.com" →
# <name>.devsfleet.com. Also stops a tenant claiming the platform's own hosts
# (pos, pos-api, cdn…) as a shop. Empty = no free addresses, no subdomain rules.
STOREFRONT_BASE_DOMAIN=
# Card payments go to a test page instead of a gateway. Refused in production.
STOREFRONT_DEV_PAYMENTS=false
# Defaults to true in production. Local http needs false.
# STOREFRONT_COOKIE_SECURE=false
# Each tenant connects its own Stripe account in Admin -> Online Store; there
# is deliberately no platform-wide Stripe key.
