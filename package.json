{
  "name": "devsfleet",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.2.2",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "clean": "turbo run clean",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md,yml,yaml}\"",
    "db:generate": "pnpm --filter @devsfleet/db generate",
    "db:migrate": "pnpm --filter @devsfleet/db migrate",
    "db:seed": "pnpm --filter @devsfleet/db seed",
    "db:studio": "pnpm --filter @devsfleet/db studio",
    "db:reset": "pnpm --filter @devsfleet/db reset",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "infra:logs": "docker compose logs -f",
    "infra:nuke": "docker compose down -v",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "verify": "pnpm check:boundaries && pnpm typecheck && pnpm test && pnpm build",
    "docker:build:api": "docker build -f apps/api/Dockerfile -t devsfleet/api:$(git rev-parse --short HEAD) -t devsfleet/api:latest .",
    "docker:build:admin": "docker build -f apps/admin/Dockerfile -t devsfleet/admin:$(git rev-parse --short HEAD) -t devsfleet/admin:latest .",
    "docker:build": "pnpm docker:build:api && pnpm docker:build:admin",
    "prod:up": "docker compose -f deploy/docker-compose.prod.yml --env-file deploy/.env up -d",
    "prod:down": "docker compose -f deploy/docker-compose.prod.yml --env-file deploy/.env down",
    "prod:logs": "docker compose -f deploy/docker-compose.prod.yml --env-file deploy/.env logs -f",
    "prod:migrate": "docker compose -f deploy/docker-compose.prod.yml --env-file deploy/.env --profile migrate run --rm migrate",
    "prod:ps": "docker compose -f deploy/docker-compose.prod.yml --env-file deploy/.env ps",
    "bundle:api": "pnpm --filter=@devsfleet/api build && pnpm deploy --filter=@devsfleet/api --prod --legacy .bundle/api",
    "bundle:admin": "pnpm --filter=@devsfleet/admin build",
    "verify:rls": "node scripts/verify-rls.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "prettier": "^3.6.2",
    "turbo": "^2.5.4",
    "typescript": "^5.9.2",
    "postgres": "^3.4.7"
  }
}
