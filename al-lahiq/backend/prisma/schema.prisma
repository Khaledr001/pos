// Al-Lahiq building materials store — database schema.
//
// Ownership rules (see PLAN.md):
// - The POS is the master for SKUs, prices and stock. Tables marked "POS mirror"
//   are written only by the pos-sync module.
// - The website is the master for content (descriptions, images, SEO) and
//   online orders.
// - Money is stored as integer fils (1 AED = 100 fils), always VAT-exclusive
//   unless the column name says otherwise.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────────── Enums ─────────────────────────────

enum Emirate {
  ABU_DHABI
  DUBAI
  SHARJAH
  AJMAN
  UMM_AL_QUWAIN
  RAS_AL_KHAIMAH
  FUJAIRAH
}

enum VatClass {
  STANDARD_5
  ZERO
  EXEMPT
}

enum PriceListType {
  RETAIL
  TRADE
  PROMO
}

enum PriceChannel {
  ALL
  POS
  ONLINE
}

enum CustomerType {
  RETAIL
  TRADE
}

enum TradeStatus {
  NONE
  PENDING
  APPROVED
  REJECTED
}

enum StaffRole {
  OWNER
  MANAGER
  ORDER_STAFF
  CONTENT_EDITOR
}

enum OrderStatus {
  PENDING_PAYMENT
  PLACED
  CONFIRMED
  PACKED
  SHIPPED
  READY_FOR_PICKUP
  DELIVERED
  COLLECTED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentMethod {
  CARD
  APPLE_PAY
  GOOGLE_PAY
  COD
  TABBY
  TAMARA
}

enum DeliveryMethod {
  COURIER
  PICKUP
}

enum CartStatus {
  ACTIVE
  CONVERTED
  ABANDONED
}

enum CouponType {
  PERCENT
  FIXED
  FREE_SHIPPING
}

enum ProductLinkKind {
  RELATED
  ALTERNATIVE
  BOUGHT_TOGETHER
}

enum InboundEventStatus {
  RECEIVED
  PROCESSED
  SKIPPED
  FAILED
}

enum OutboxStatus {
  PENDING
  SENT
  FAILED
  DEAD
}

enum SyncRunStatus {
  RUNNING
  SUCCEEDED
  FAILED
}

// ───────────────────────────── Branches ─────────────────────────────

model Branch {
  id            String   @id @default(uuid()) @db.Uuid
  code          String   @unique // POS branch code
  name          String
  emirate       Emirate
  address       String
  phone         String?
  lat           Float?
  lng           Float?
  openingHours  Json? // { "mon": "08:00-20:00", ... }
  pickupEnabled Boolean  @default(true)
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  stockLevels  StockLevel[]
  pickupOrders Order[]

  @@map("branches")
}

// ───────────────────────────── Catalog ─────────────────────────────

model Category {
  id             String   @id @default(uuid()) @db.Uuid
  parentId       String?  @db.Uuid
  slug           String   @unique
  name           String
  description    String?
  imageUrl       String?
  sortOrder      Int      @default(0)
  active         Boolean  @default(true)
  seoTitle       String?
  seoDescription String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryTree")
  products Product[]

  @@index([parentId])
  @@map("categories")
}

model Brand {
  id          String   @id @default(uuid()) @db.Uuid
  slug        String   @unique
  name        String
  logoUrl     String?
  description String?
  featured    Boolean  @default(false)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products Product[]

  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "brands_name_trgm_idx")
  @@map("brands")
}

/// A filterable attribute such as size, colour, wattage or gauge.
model Attribute {
  id         String  @id @default(uuid()) @db.Uuid
  code       String  @unique // e.g. "size", "colour", "wattage"
  name       String
  unit       String? // e.g. "W", "mm", "V"
  filterable Boolean @default(true)
  sortOrder  Int     @default(0)

  values VariantAttribute[]

  @@map("attributes")
}

/// Product = the website's content record. It groups one or more variants (SKUs).
model Product {
  id             String   @id @default(uuid()) @db.Uuid
  slug           String   @unique
  name           String
  description    String? // website-owned rich text (markdown)
  brandId        String?  @db.Uuid
  categoryId     String?  @db.Uuid
  vatClass       VatClass @default(STANDARD_5)
  posGroupCode   String?  @unique // POS product family; groups several SKUs on one page
  pickupOnly     Boolean  @default(false) // heavy/bulky items: no courier
  published      Boolean  @default(false) // website content flag
  featured       Boolean  @default(false)
  // Denormalised by CatalogIndexer whenever retail prices or stock change,
  // so listings can filter and sort in SQL.
  fromNetPriceFils Int?
  inStock          Boolean @default(false)
  specs          Json? // [{ "label": "Material", "value": "Brass" }]
  seoTitle       String?
  seoDescription String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  brand     Brand?            @relation(fields: [brandId], references: [id], onDelete: SetNull)
  category  Category?         @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  variants  Variant[]
  images    ProductImage[]
  documents ProductDocument[]
  links     ProductLink[]     @relation("ProductLinkFrom")
  linkedBy  ProductLink[]     @relation("ProductLinkTo")

  @@index([categoryId])
  @@index([brandId])
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "products_name_trgm_idx")
  @@map("products")
}

/// Variant = one sellable SKU. POS mirror for sku/barcode/uom/weight/active.
model Variant {
  id          String   @id @default(uuid()) @db.Uuid
  productId   String   @db.Uuid
  sku         String   @unique
  barcode     String?
  name        String // variant label, e.g. `1/2" · White`
  options     Json? // { "size": "1/2\"", "colour": "White" }
  baseUom     String   @default("pc") // pc, m, roll, box, bag, sqm, l, kg
  weightGrams Int      @default(0)
  active      Boolean  @default(true) // POS active flag
  sortOrder   Int      @default(0)
  posVersion  Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  product        Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  uomConversions UomConversion[]
  attributes     VariantAttribute[]
  stockLevels    StockLevel[]
  cartItems      CartItem[]
  orderLines     OrderLine[]
  projectItems   ProjectListItem[]

  @@index([productId])
  @@index([sku(ops: raw("gin_trgm_ops"))], type: Gin, map: "variants_sku_trgm_idx")
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "variants_name_trgm_idx")
  @@map("variants")
}

/// How many base units one `uom` contains, e.g. 1 box = 1.44 sqm.
model UomConversion {
  id        String  @id @default(uuid()) @db.Uuid
  variantId String  @db.Uuid
  uom       String
  factor    Decimal @db.Decimal(14, 4)

  variant Variant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([variantId, uom])
  @@map("uom_conversions")
}

model VariantAttribute {
  variantId    String  @db.Uuid
  attributeId  String  @db.Uuid
  value        String
  numericValue Float?

  variant   Variant   @relation(fields: [variantId], references: [id], onDelete: Cascade)
  attribute Attribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)

  @@id([variantId, attributeId])
  @@index([attributeId, value])
  @@map("variant_attributes")
}

model ProductImage {
  id        String @id @default(uuid()) @db.Uuid
  productId String @db.Uuid
  url       String
  alt       String?
  sortOrder Int    @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_images")
}

model ProductDocument {
  id        String @id @default(uuid()) @db.Uuid
  productId String @db.Uuid
  title     String
  url       String
  kind      String @default("datasheet") // datasheet | manual | certificate

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_documents")
}

model ProductLink {
  fromId    String          @db.Uuid
  toId      String          @db.Uuid
  kind      ProductLinkKind
  sortOrder Int             @default(0)

  from Product @relation("ProductLinkFrom", fields: [fromId], references: [id], onDelete: Cascade)
  to   Product @relation("ProductLinkTo", fields: [toId], references: [id], onDelete: Cascade)

  @@id([fromId, toId, kind])
  @@map("product_links")
}

// ───────────────────────────── Stock (POS mirror) ─────────────────────────────

model StockLevel {
  variantId  String   @db.Uuid
  branchId   String   @db.Uuid
  quantity   Decimal  @db.Decimal(14, 3) // in base uom, as reported by POS
  posVersion Int      @default(0)
  updatedAt  DateTime @updatedAt

  variant Variant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  branch  Branch  @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@id([variantId, branchId])
  @@map("stock_levels")
}

// ───────────────────────────── Pricing (POS mirror) ─────────────────────────────

model PriceList {
  id        String        @id @default(uuid()) @db.Uuid
  code      String        @unique // POS price list code
  name      String
  type      PriceListType
  channel   PriceChannel  @default(ALL)
  priority  Int           @default(0)
  validFrom DateTime?
  validTo   DateTime?
  active    Boolean       @default(true)
  version   Int           @default(0)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  items     PriceListItem[]
  customers CustomerPriceList[]

  @@map("price_lists")
}

/// Not FK-linked to variants on purpose: prices may arrive before the product.
model PriceListItem {
  id            String   @id @default(uuid()) @db.Uuid
  priceListId   String   @db.Uuid
  sku           String
  uom           String
  minQty        Decimal  @default(1) @db.Decimal(14, 3)
  netPriceFils  Int
  updatedAt     DateTime @updatedAt

  priceList PriceList @relation(fields: [priceListId], references: [id], onDelete: Cascade)

  @@unique([priceListId, sku, uom, minQty])
  @@index([sku])
  @@map("price_list_items")
}

model CustomerPriceList {
  customerId  String @db.Uuid
  priceListId String @db.Uuid

  customer  Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  priceList PriceList @relation(fields: [priceListId], references: [id], onDelete: Cascade)

  @@id([customerId, priceListId])
  @@map("customer_price_lists")
}

// ───────────────────────────── People ─────────────────────────────

model Customer {
  id              String       @id @default(uuid()) @db.Uuid
  email           String       @unique
  phone           String?
  passwordHash    String
  firstName       String
  lastName        String
  companyName     String?
  trn             String? // UAE Tax Registration Number, for B2B invoices
  type            CustomerType @default(RETAIL)
  tradeStatus     TradeStatus  @default(NONE)
  posCustomerCode String?      @unique
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  addresses    Address[]
  carts        Cart[]
  orders       Order[]
  priceLists   CustomerPriceList[]
  projectLists ProjectList[]

  @@map("customers")
}

model StaffUser {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique
  passwordHash String
  name         String
  role         StaffRole
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("staff_users")
}

/// Rotating refresh tokens. Reusing a revoked token revokes the whole family.
model RefreshToken {
  id          String    @id @default(uuid()) @db.Uuid
  subjectType String // "customer" | "staff"
  subjectId   String    @db.Uuid
  familyId    String    @db.Uuid
  tokenHash   String    @unique
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([subjectType, subjectId])
  @@index([familyId])
  @@map("refresh_tokens")
}

model Address {
  id         String   @id @default(uuid()) @db.Uuid
  customerId String   @db.Uuid
  label      String? // "Home", "Site - Al Barsha villa"
  fullName   String
  phone      String
  emirate    Emirate
  area       String
  street     String
  building   String?
  landmark   String?
  lat        Float?
  lng        Float?
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@map("addresses")
}

// ───────────────────────────── Carts & lists ─────────────────────────────

model Cart {
  id         String     @id @default(uuid()) @db.Uuid
  customerId String?    @db.Uuid
  status     CartStatus @default(ACTIVE)
  couponCode String?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  customer Customer?  @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items    CartItem[]

  @@index([customerId, status])
  @@map("carts")
}

model CartItem {
  id                 String   @id @default(uuid()) @db.Uuid
  cartId             String   @db.Uuid
  variantId          String   @db.Uuid
  uom                String
  quantity           Decimal  @db.Decimal(14, 3)
  seenUnitNetFils    Int // price shown when added; used to detect price changes
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant Variant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([cartId, variantId, uom])
  @@map("cart_items")
}

/// Wishlist and named project lists ("Villa bathroom").
model ProjectList {
  id         String   @id @default(uuid()) @db.Uuid
  customerId String   @db.Uuid
  name       String
  isWishlist Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  customer Customer          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  items    ProjectListItem[]

  @@index([customerId])
  @@map("project_lists")
}

model ProjectListItem {
  id        String  @id @default(uuid()) @db.Uuid
  listId    String  @db.Uuid
  variantId String  @db.Uuid
  uom       String
  quantity  Decimal @default(1) @db.Decimal(14, 3)

  list    ProjectList @relation(fields: [listId], references: [id], onDelete: Cascade)
  variant Variant     @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([listId, variantId, uom])
  @@map("project_list_items")
}

// ───────────────────────────── Orders ─────────────────────────────

model Order {
  id             String         @id @default(uuid()) @db.Uuid
  orderNumber    String         @unique // AL-000123
  customerId     String?        @db.Uuid
  email          String
  phone          String
  fullName       String
  status         OrderStatus    @default(PENDING_PAYMENT)
  paymentStatus  PaymentStatus  @default(PENDING)
  paymentMethod  PaymentMethod
  deliveryMethod DeliveryMethod
  shippingAddress Json? // snapshot of the address at order time
  pickupBranchId String?        @db.Uuid
  pickupSlotStart DateTime?
  pickupSlotEnd   DateTime?
  companyName    String?
  trn            String?
  couponCode     String?
  notes          String?
  subtotalNetFils Int
  discountNetFils Int           @default(0)
  shippingNetFils Int           @default(0)
  vatFils        Int
  totalFils      Int // VAT-inclusive grand total
  weightGrams    Int            @default(0)
  // [{ variantId, branchId, qty }] taken from the local stock copy; restored on cancel
  stockDeductions Json?
  trackingToken  String         @unique @default(uuid()) @db.Uuid // for guest tracking links
  placedAt       DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  customer      Customer?            @relation(fields: [customerId], references: [id], onDelete: SetNull)
  pickupBranch  Branch?              @relation(fields: [pickupBranchId], references: [id], onDelete: SetNull)
  lines         OrderLine[]
  statusHistory OrderStatusHistory[]
  payments      Payment[]
  shipments     Shipment[]
  invoice       Invoice?

  @@index([customerId])
  @@index([status])
  @@index([createdAt])
  @@map("orders")
}

model OrderLine {
  id                String   @id @default(uuid()) @db.Uuid
  orderId           String   @db.Uuid
  variantId         String?  @db.Uuid
  sku               String
  name              String
  uom               String
  quantity          Decimal  @db.Decimal(14, 3)
  unitNetFils       Int // price charged, VAT-exclusive
  unitRetailNetFils Int // retail price for comparison
  priceListId       String?  @db.Uuid
  priceListCode     String?
  priceVersion      Int?
  vatRateBps        Int // 500 = 5%
  lineNetFils       Int // unit net × quantity, before the order-level discount
  lineVatFils       Int // VAT on this line after its share of the order discount
  lineTotalFils     Int // line price incl. VAT before the order discount (as shown in the cart)

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant Variant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@map("order_lines")
}

model OrderStatusHistory {
  id        String      @id @default(uuid()) @db.Uuid
  orderId   String      @db.Uuid
  status    OrderStatus
  note      String?
  actor     String? // "system", "pos", staff email
  createdAt DateTime    @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("order_status_history")
}

model Payment {
  id          String        @id @default(uuid()) @db.Uuid
  orderId     String        @db.Uuid
  provider    String // "cod", "stripe", "tabby"...
  providerRef String?
  method      PaymentMethod
  amountFils  Int
  status      PaymentStatus
  raw         Json?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([provider, providerRef])
  @@index([orderId])
  @@map("payments")
}

model Shipment {
  id             String   @id @default(uuid()) @db.Uuid
  orderId        String   @db.Uuid
  courier        String
  trackingNumber String?
  trackingUrl    String?
  labelUrl       String?
  status         String   @default("CREATED")
  events         Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("shipments")
}

model Invoice {
  id            String   @id @default(uuid()) @db.Uuid
  orderId       String   @unique @db.Uuid
  invoiceNumber String   @unique // INV-2026-000123
  issuedAt      DateTime @default(now())
  sellerTrn     String
  buyerTrn      String?
  totalNetFils  Int
  vatFils       Int
  totalFils     Int

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("invoices")
}

/// Human-friendly sequential numbers (orders, invoices).
model Counter {
  name  String @id
  value Int    @default(0)

  @@map("counters")
}

// ───────────────────────────── Promotions & delivery ─────────────────────────────

model Coupon {
  id              String     @id @default(uuid()) @db.Uuid
  code            String     @unique
  type            CouponType
  value           Int // percent (0-100) or fils
  minSubtotalFils Int        @default(0)
  maxUses         Int?
  usedCount       Int        @default(0)
  validFrom       DateTime?
  validTo         DateTime?
  active          Boolean    @default(true)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@map("coupons")
}

model ShippingRate {
  id             String   @id @default(uuid()) @db.Uuid
  emirate        Emirate  @unique
  baseFils       Int // up to baseWeightKg
  baseWeightKg   Int      @default(5)
  perKgFils      Int // each kg over baseWeightKg
  freeOverFils   Int? // free shipping when net subtotal >= this
  maxWeightKg    Int      @default(30) // courier limit per order
  etaDays        Int      @default(2)
  active         Boolean  @default(true)
  updatedAt      DateTime @updatedAt

  @@map("shipping_rates")
}

/// Key/value store settings: store TRN, COD limit, stock safety buffer, pickup slots...
model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt

  @@map("settings")
}

// ───────────────────────────── Content ─────────────────────────────

model Page {
  id             String   @id @default(uuid()) @db.Uuid
  slug           String   @unique
  title          String
  body           String // markdown
  kind           String   @default("page") // page | blog
  excerpt        String?
  coverImageUrl  String?
  published      Boolean  @default(false)
  publishedAt    DateTime?
  seoTitle       String?
  seoDescription String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([kind, published])
  @@map("pages")
}

model Banner {
  id        String    @id @default(uuid()) @db.Uuid
  placement String    @default("home_hero") // home_hero | home_strip
  title     String
  subtitle  String?
  imageUrl  String?
  linkUrl   String?
  ctaLabel  String?
  sortOrder Int       @default(0)
  active    Boolean   @default(true)
  startsAt  DateTime?
  endsAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("banners")
}

// ───────────────────────────── POS sync ─────────────────────────────

model InboundEvent {
  id          String             @id @default(uuid()) @db.Uuid
  eventId     String             @unique // idempotency key from the POS
  type        String
  payload     Json
  status      InboundEventStatus @default(RECEIVED)
  attempts    Int                @default(0)
  error       String?
  receivedAt  DateTime           @default(now())
  processedAt DateTime?

  @@index([status, receivedAt])
  @@map("inbound_events")
}

/// Transactional outbox: written in the same transaction as the change.
model OutboxEvent {
  id            String       @id @default(uuid()) @db.Uuid // doubles as the idempotency key
  type          String
  aggregateId   String
  payload       Json
  status        OutboxStatus @default(PENDING)
  attempts      Int          @default(0)
  lastError     String?
  nextAttemptAt DateTime     @default(now())
  createdAt     DateTime     @default(now())
  sentAt        DateTime?

  @@index([status, nextAttemptAt])
  @@map("outbox_events")
}

model SyncRun {
  id         String        @id @default(uuid()) @db.Uuid
  kind       String // "reconciliation"
  status     SyncRunStatus @default(RUNNING)
  summary    Json?
  error      String?
  startedAt  DateTime      @default(now())
  finishedAt DateTime?

  @@index([kind, startedAt])
  @@map("sync_runs")
}

// ───────────────────────────── Analytics ─────────────────────────────

model SearchLog {
  id        String   @id @default(uuid()) @db.Uuid
  term      String
  results   Int
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("search_logs")
}
