NODE_ENV=development
PORT=4000
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/al_lahiq_dev"
REDIS_URL=redis://localhost:6379

# Auth: generate with `openssl rand -hex 32`
JWT_SECRET=change-me-to-a-long-random-string-of-32-chars-or-more
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# COOKIE_DOMAIN=.yourdomain.ae
COOKIE_SECURE=false

FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
REVALIDATE_SECRET=change-me-revalidate-secret

# POS integration (see docs/pos-integration.yaml)
POS_WEBHOOK_SECRET=change-me-pos-to-website-secret
POS_OUTBOUND_SECRET=change-me-website-to-pos-secret
# POS_BASE_URL=http://localhost:5000
RECONCILIATION_CRON="0 2 * * *"

# Payments
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
DEV_PAYMENTS=true

# Notifications (logged to console when unset)
# RESEND_API_KEY=
MAIL_FROM="Al-Lahiq <orders@example.ae>"
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=

QUEUES_ENABLED=true
SCHEDULER_ENABLED=true
