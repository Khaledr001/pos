# =============================================================================
# DevsFleet online store — copy to apps/storefront/.env on the VPS.
#
#   cp deploy/storefront.env.example apps/storefront/.env
#
# deploy.sh builds and starts the storefront only when that file exists, and
# PM2 starts it with `node --env-file=apps/storefront/.env`. One process serves
# EVERY tenant's shop: the visitor's hostname (allahiq.devsfleet.com) picks the
# tenant, through the API's storefront_domains table.
# =============================================================================

# Where the storefront reaches the API — on the same host, so loopback, not the
# public URL. Also read at BUILD time: next.config writes the browser's
# /api/v1 rewrite into the build, so changing it needs a redeploy.
API_ORIGIN=http://127.0.0.1:3001

# Must equal STOREFRONT_PROXY_SECRET in apps/api/.env. Proves to the API that
# a call comes from this storefront, so it may pass on the shopper's IP and the
# API rate-limits each shopper instead of the whole shop as one client.
# 32+ characters: openssl rand -hex 32
STOREFRONT_PROXY_SECRET=

# Must equal STOREFRONT_REVALIDATE_SECRET in apps/api/.env. The API sends it
# to https://<shop>/api/revalidate when prices or stock change, so pages
# refresh within a minute instead of waiting out their cache.
# 16+ characters: openssl rand -hex 24
REVALIDATE_SECRET=

# --- Leave these EMPTY when serving many tenants -------------------------------
# Either one pins every shop to a single hostname. STOREFRONT_HOST makes every
# visitor see that one tenant's store; NEXT_PUBLIC_SITE_URL is compiled into
# the build and would make every shop's canonical links, sitemap and structured
# data point at it. Without them both are taken from the request.
STOREFRONT_HOST=
NEXT_PUBLIC_SITE_URL=
