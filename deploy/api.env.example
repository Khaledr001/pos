# =============================================================================
# apps/api/.env — PRODUCTION, for the PM2 deployment on this VPS.
#
#   cp deploy/api.env.example apps/api/.env
#   chmod 600 apps/api/.env
#
# PM2 does not inject these; the API reads this file itself at boot (NestJS
# ConfigModule, resolved from process.cwd() — which is why the PM2 config sets
# cwd to apps/api). Keeping secrets here rather than in ecosystem.config.cjs is
# deliberate: that file is committed, this one is not.
#
# A real environment variable WINS over anything written here.
#
# Every value is validated at boot by apps/api/src/config/env.ts. A missing or
# malformed one crashes the process immediately with a readable list, rather
# than surfacing at the counter when a cashier tries to log in.
# =============================================================================

NODE_ENV=production

# -----------------------------------------------------------------------------
# Database — the APP role, RLS ENFORCED.
#
# 127.0.0.1:5433 is the containerised Postgres from docker-compose.data.yml.
# NEVER point this at devsfleet_migrator: that role bypasses row-level security,
# and every tenant would read every other tenant's data.
#
# The password must match APP_DB_PASSWORD in deploy/.env. If it contains any of
# : / ? # [ ] @ then percent-encode it, or the URL parser will mis-read it.
# -----------------------------------------------------------------------------
DATABASE_URL=postgres://devsfleet_app:CHANGE_ME@127.0.0.1:5433/devsfleet
DATABASE_POOL_MAX=10
# The connection never leaves the host, so TLS buys nothing here.
DATABASE_SSL=false

# Must match REDIS_PASSWORD in deploy/.env.
REDIS_URL=redis://:CHANGE_ME@127.0.0.1:6380

# -----------------------------------------------------------------------------
# Auth — generate EACH with: openssl rand -base64 48
#
# The two MUST differ, and the API refuses to boot if they match: sharing them
# lets an access token be replayed as a refresh token. It also rejects any
# secret with fewer than 12 distinct characters, so padding a short string to
# reach the length limit will not get past it.
# -----------------------------------------------------------------------------
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_TTL=30d
# Terminals stay signed in far longer than browsers; they are physically controlled.
JWT_POS_REFRESH_TTL=90d
BCRYPT_ROUNDS=12

# -----------------------------------------------------------------------------
# HTTP
#
# API_PORT is loopback-only in practice — nginx is the sole way in.
# -----------------------------------------------------------------------------
API_PORT=3001
API_PREFIX=api/v1

# Comma-separated, and it must list every browser origin that calls this API.
# The POS is Electron and sends no Origin header, so it needs no entry here.
API_CORS_ORIGINS=https://pos.devsfleet.com,http://localhost:5173,http://localhost:4000

THROTTLE_TTL=60
THROTTLE_LIMIT=120

# -----------------------------------------------------------------------------
# Object storage
#
# S3_ENDPOINT is where the API writes (loopback, direct to MinIO).
# S3_PUBLIC_URL is what a browser fetches — through nginx, which serves only
# the */products/* prefix. They differ on purpose.
# -----------------------------------------------------------------------------
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=devsfleet
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_URL=https://cdn.devsfleet.com/devsfleet

# -----------------------------------------------------------------------------
# Email — shopper notifications (order updates, quotes, back-in-stock)
# One platform SMTP account for every shop (SES, Postmark, Resend SMTP, ...).
# MAIL_FROM_ADDRESS must be an address your provider has verified (SPF/DKIM on
# its domain); each shop only chooses the display name and reply-to.
# Leave SMTP_HOST empty and email shows as "not configured" in the admin; mail
# is then logged, never sent.
# -----------------------------------------------------------------------------
MAIL_DRIVER=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM_ADDRESS=

# -----------------------------------------------------------------------------
# Secrets at rest + UAE e-invoicing (docs/EINVOICING.md)
# APP_ENCRYPTION_KEY encrypts credentials stored in the database (today: a
# tenant's e-invoicing provider key). 32 bytes: `openssl rand -hex 32`.
# REQUIRED in production for e-invoicing providers: unset, saving provider
# credentials is refused. Changing it later makes
# stored credentials unreadable — tenants must re-enter them.
# EINVOICE_GATEWAY_ALLOW_PRIVATE lets the gateway driver reach a local mock
# provider on a private address. Ignored when NODE_ENV=production.
# -----------------------------------------------------------------------------
APP_ENCRYPTION_KEY=
# (EINVOICE_GATEWAY_ALLOW_PRIVATE is ignored in production; leave it out.)

# -----------------------------------------------------------------------------
# WhatsApp — Meta Cloud API
#
# Leave WHATSAPP_ENABLED=false until the Meta app is configured. Setting it
# true makes the four values below mandatory and the API will not boot without
# WHATSAPP_APP_SECRET, because webhook signatures could not be verified and
# anyone who learned the URL could inject messages.
#
# Per-tenant numbers are stored in the whatsapp_accounts table, not here.
# The webhook Meta must be pointed at is:
#     https://api.devsfleet.com/api/v1/whatsapp/webhook
# -----------------------------------------------------------------------------
WHATSAPP_ENABLED=false
WHATSAPP_API_VERSION=v23.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# --- WhatsApp Embedded Signup (one-click connect, keeps the WhatsApp Business app working) ---
# All four, or none: leave any blank and only the manual setup is offered.
# Setup checklist: docs/WHATSAPP_EMBEDDED_SIGNUP.md
# Meta App Dashboard → App settings → Basic → App ID.
META_APP_ID=
# Same page → App secret. Server-only. Signs webhooks for numbers connected this way.
META_APP_SECRET=
# Meta App Dashboard → Facebook Login for Business → Configurations → the Embedded Signup config's ID.
META_EMBEDDED_SIGNUP_CONFIG_ID=
# The verify token you type into the app's WhatsApp webhook settings in Meta. Any long random string.
META_WEBHOOK_VERIFY_TOKEN=

# -----------------------------------------------------------------------------
# AI
# -----------------------------------------------------------------------------
LLM_PROVIDER=deepseek
# Blank = the provider's recommended default (deepseek-v4-flash).
LLM_MODEL=
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
LLM_MAX_TOKENS=1024
LLM_TIMEOUT_MS=20000

# -----------------------------------------------------------------------------
# Migrations only. Read by packages/db/scripts/migrate.ts, never by the API.
# Keep it out of the API's own environment so a compromised API process cannot
# find a BYPASSRLS credential lying in its own env.
# -----------------------------------------------------------------------------
# DATABASE_URL_MIGRATOR=postgres://devsfleet_migrator:CHANGE_ME@127.0.0.1:5433/devsfleet

# -----------------------------------------------------------------------------
# Online store (apps/storefront)
# -----------------------------------------------------------------------------
# Signs shopper tokens. Optional — derived from JWT_ACCESS_SECRET when blank,
# which is still a different key from the staff one.
STOREFRONT_JWT_SECRET=
# Sent to each storefront's /api/revalidate when prices or stock change.
# Must match REVALIDATE_SECRET on the storefront. Blank = pages expire on TTL.
STOREFRONT_REVALIDATE_SECRET=
# Shared with the storefront server. Without it every shopper counts against
# the storefront's single IP in the rate limiter. Generate: openssl rand -hex 32
STOREFRONT_PROXY_SECRET=

# The platform domain tenants get a free shop address on: "devsfleet.com" →
# <name>.devsfleet.com. Also stops a tenant claiming the platform's own hosts
# (pos, pos-api, cdn…) as a shop. Empty = no free addresses, no subdomain rules.
STOREFRONT_BASE_DOMAIN=devsfleet.com
# Card payments go to a test page instead of a gateway. Refused in production.
STOREFRONT_DEV_PAYMENTS=false
# Defaults to true in production. Local http needs false.
# STOREFRONT_COOKIE_SECURE=false
# Each tenant connects its own Stripe account in Admin -> Online Store; there
# is deliberately no platform-wide Stripe key.
