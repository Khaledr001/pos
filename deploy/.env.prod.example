# =============================================================================
# deploy/.env — configures the DATA STACK (docker-compose.data.yml)
#
#   cp .env.prod.example .env && chmod 600 .env
#
# This file holds the credentials Docker needs to CREATE the data services.
# The API's own settings live in apps/api/.env — see apps/api/.env.example.
# The two files repeat two passwords by necessity; nothing else overlaps.
#
# Never commit this file.
# =============================================================================

# -----------------------------------------------------------------------------
# Database — generate each with: openssl rand -base64 32
#
# Two roles, and the separation IS tenant isolation:
#   migrator  owns the schema, BYPASSES RLS. Migrations and backups only.
#   app       what the API connects as. RLS is ENFORCED against it.
#
# These are read only when the Postgres volume is first created. Changing them
# here later does nothing — see docs/DEPLOYMENT.md, "Rotating a password".
# -----------------------------------------------------------------------------
MIGRATOR_DB_PASSWORD=
APP_DB_PASSWORD=

REDIS_PASSWORD=

# -----------------------------------------------------------------------------
# Object storage (MinIO root credentials)
# -----------------------------------------------------------------------------
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=devsfleet

# -----------------------------------------------------------------------------
# Host ports — loopback only, and shifted off the defaults so they sit beside
# the PostgreSQL and Redis already serving the ISP system on 5432 and 6379.
#
# Change these only if something else on the VPS already holds them; check with
#   sudo ss -tlnp | grep -E '5433|6380|9000|9001'
# -----------------------------------------------------------------------------
POSTGRES_HOST_PORT=5433
REDIS_HOST_PORT=6380
MINIO_HOST_PORT=9000
MINIO_CONSOLE_PORT=9001

# -----------------------------------------------------------------------------
# Only used by the all-in-Docker variant (docker-compose.prod.yml), which this
# deployment does NOT use — the API and admin run under PM2 on the host.
# Kept so that file still resolves if you ever switch.
# -----------------------------------------------------------------------------
DOMAIN_ADMIN=pos.devsfleet.com
DOMAIN_API=api.devsfleet.com
DOMAIN_CDN=cdn.devsfleet.com
ACME_EMAIL=you@devsfleet.com
REGISTRY=devsfleet
TAG=latest
