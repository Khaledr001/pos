()) {\n      return emit({ syncing: false, online: true, lastError: \"Signed out \u2014 enter a PIN\" });\n    }\n\n    try {\n      await pushOutbox();\n      await pullChanges();\n      clearSettledDeltas();\n      return emit({ syncing: false, online: true, lastError: null });\n    } catch (error) {\n      const message = error instanceof Error ? error.message : \"Sync failed\";\n      return emit({\n        syncing: false,\n        // An auth or validation failure means the server answered, so the\n        // terminal is online \u2014 flagging it offline would send a cashier to\n        // check a router that is working fine.\n        online: error instanceof ApiError,\n        lastError: message,\n      });\n    }\n  })", "is_member_call": false, "source_file": "/media/khaled/Education/DevsFleet/DevsFleet POS/apps/pos/electron/sync/index.ts", "source_location": "L98"}, {"caller_nid": "sync_index_pushoutbox", "callee": "pendingOutbox", "is_member_call": false, "source_file": "/media/khaled/Education/DevsFleet/DevsFleet POS/apps/pos/electron/sync/index.ts", "source_location": "L142"}, {"caller_nid": "sync_index_pushoutbox", "callee": "await authorized", "is_member_call": false, "source_file": "/media/khaled/Education/DevsFleet/DevsFleet POS/apps/pos/electron/sync/index.ts", "source_location": "L145"}, {"caller_nid": "sync_index_pushoutbox", "callee": "deviceId", "is_member_call": false, "source_file": "/media/khaled/Education/DevsFleet/DevsFleet POS/apps/pos/electron/sync/index.ts", "source_location": "L154"}, {"caller_nid": "sync_index_pushoutbox", "callee": "getState", "is_member_call": false, "source_file": "/media/khaled/Education/DevsFleet/DevsFleet POS/apps/pos/electron/sync/index.ts", "source_location": "L155"}, {"caller_nid": "sync_index_pushoutbox", "callee": "map", "is_member_call": true, "source_file": "/media/khaled/Education/DevsFleet/DevsFleet POS/apps/pos/electron/sync/index.ts", "source_location": "L161"}, {"caller_nid": "sync_index_pushoutbox", "