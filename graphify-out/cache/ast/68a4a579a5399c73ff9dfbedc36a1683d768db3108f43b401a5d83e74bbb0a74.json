": "/media/khaled/Education/DevsFleet/DevsFleet POS/apps/pos/electron/db/sqlite.ts", "source_location": "L35"}, {"caller_nid": "db_sqlite_ensurecolumns", "callee": "pragma", "is_member_call": true, "source_file": "/media/khaled/Education/DevsFleet/DevsFleet POS/apps/pos/electron/db/sqlite.ts", "source_location": "L39"}, {"caller_nid": "db_sqlite_ensurecolumns", "callee": "some", "is_member_call": true, "source_file": "/media/khaled/Education/DevsFleet/DevsFleet POS/apps/pos/electron/db/sqlite.ts", "source_location": "L40"}, {"caller_nid": "db_sqlite_ensurecolumns", "callee": "exec", "is_member_call": true, "source_file": "/media/khaled/Education/DevsFleet/DevsFleet POS/apps/pos/electron/db/sqlite.ts", "source_location": "L41"}, {"caller_nid": "db_sqlite_ensurecolumns", "callee": "warn", "is_member_call": true, "source_file": "/media/khaled/Education/DevsFleet/DevsFleet POS/apps/pos/electron/db/sqlite.ts", "source_location": "L44"}, {"caller_nid": "db_sqlite_seedinitialcatalog", "callee": "get", "is_member_call": true, "source_file": "/media/khaled/Education/DevsFleet/DevsFleet POS/apps/pos/electron/db/sqlite.ts", "source_location": "L214"}, {"caller_nid": "db_sqlite_seedinitialcatalog", "callee": "prepare", "is_member_call": true, "source_file": "/media/khaled/Education/DevsFleet/DevsFleet POS/apps/pos/electron/db/sqlite.ts", "source_location": "L214"}, {"caller_nid": "db_sqlite_seedinitialcatalog", "callee": "database.transaction(() => {\n      const insertVariant = database.prepare(`\n        INSERT OR IGNORE INTO variants (id, product_id, sku, barcode, product_name, variant_name, search_key, unit_abbr, category_name, tax_rate, updated_at)\n        VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, datetime('now'))\n      `);\n\n      const insertPrice = database.prepare(`\n        INSERT OR IGNORE INTO variant_prices (id, variant_id, price_list_id, selling_price, min_selling_price, is_default, updated_at)\n        VALUES (?, ?, 'default', ?, ?, 1, datetime('now'))\n      `);\n\n      const insertInventory = database.prepare(`\n        INSERT OR IGNORE INTO inventory (id, variant_id, quantity, reserved_qty, local_delta, updated_at)\n        VALUES (?, ?, ?, '0', '0', datetime('now'))\n      `);\n\n      for (const item of DEFAULT_CATALOG) {\n        const searchKey = `${item.productName} ${item.sku} ${item.barcode ?? \"\"} ${item.categoryName ?? \"\"}`.toLowerCase();\n        insertVariant.run(\n          item.id,\n          item.productId,\n          item.sku,\n          item.barcode,\n          item.productName,\n          item.variantName,\n          searchKey,\n          item.unitAbbr,\n          item.categoryName,\n          item.taxRate,\n        );\n        insertPrice.run(`pr_${item.id}`, item.id, item.sellingPrice, item.minSellingPrice);\n        insertInventory.run(`inv_${item.id}`, item.id, item.stock);\n      }\n\n      const insertCustomer = database.prepare(`\n        INSERT OR IGNORE INTO customers (id, name, company, phone, trn, credit_limit, credit_balance, credit_on_hold, updated_at)\n        VALUES (?, ?, ?, ?, ?, ?, ?, 0, datetime('now'))\n      `);\n\n      for (const c of DEFAULT_CUSTOMERS) {\n        insertCustomer.run(c.id, c.name, c.company, c.phone, c.trn, c.creditLimit, c.creditBalance);\n      }\n    })", "is_member_call": false, "source_file": "/media/khaled/Education/DevsFleet/DevsFleet POS/apps/pos/electron/db/sqlite.ts", "source_location": "L217"}, {"caller_nid": "db_sqlite_seedinitialcatalog", "callee": "transaction", "is_member_call": true, "source_file": "/media/khaled/Education/DevsFleet/DevsFleet POS/apps/pos/electron/db/sqlite.ts", "source_location": "L217"}, {"caller_nid": "db_sqlite_seedinitialcatalog", "callee": "warn", "is_member_call": true, "source_file": "/media/khaled/Education/DevsFleet/DevsFleet POS/apps/pos/electron/db/sqlite.ts", "source_location": "L261"}, {"caller_nid": "db_sqlite_opendatabase", "callee": "join", "is_member_call": false, "source_file": "/media/khaled/Education/DevsFleet/DevsFleet POS/apps/pos/electron/db/sqlite.ts", "source_location": "L268"}, {"caller_nid": "db_sqlite_opendatabase", "callee": "getPath", "is_member_call": true, "source_file": "/media/khaled/Education/DevsFleet/DevsFleet POS/apps/pos/electron/db/sqlite.ts", "source_location": "L268"}, {"caller_nid": "db_sqlite_opendatabase", "callee": "pragma", "is_member_call": true, "source_file": "/media/khaled/Education/DevsFleet/DevsFleet POS/apps/pos/electron/db/sqlite.ts", "source_location": "L276"}, {"caller_nid": "db_sqlite_opendatabase", "callee": "pragma", "is_member_call": true, "source_file": "/media/khaled/Education/DevsFleet/DevsFleet POS/apps/pos/electron/db/sqlite.ts", "source_location": "L283"}, {"caller_nid": "db_sqlite_opendatabase", "callee": "pragma", "is_member_call": true, "source_file": "/media/khaled/Education/DevsFleet/DevsFleet POS/apps/pos/electron/db/sqlite.ts", "source_location": "L285"}, {"caller_nid": "db_sqlite_opendatabase", "callee": "pragma", "is_member_call": true, "source_file": "/media/khaled/Education/DevsFleet/DevsFleet POS/apps/pos/electron/db/sqlite.ts", "source_location": "L286"}, {"caller_nid": "db_sqlite_closedatabase", "callee": "pragma", "is_member_call": true, "source_file": "/media/khaled/Education/DevsFleet/DevsFleet POS/apps/pos/electron/db/sqlite.ts", "source_location": "L302"}, {"caller_nid": "db_sqlite_closedatabase", "callee": "close", "is_member_call": true, "source_file": "/media/khaled/Education/DevsFleet/DevsFleet POS/apps/pos/electron/db/sqlite.ts", "source_location": "L303"}, {"caller_nid": "db_sqlite_migrate", "callee": "pragma", "is_member_call": true, "source_file": "/media/khaled/Education/DevsFleet/DevsFleet POS/apps/pos/electron/db/sqlite.ts", "source_location": "L709"}, {"caller_nid": "db_sqlite_migrate", "callee": "at", "is_member_call": true, "source_file": "/media/khaled/Education/DevsFleet/DevsFleet POS/apps/pos/electron/db/sqlite.ts", "source_location": "L710"}, {"caller_nid": "db_sqlite_migrate", "callee": 